classDiagram
  class Core {
    +dispatch(cmd: CoreCommand) CoreResponse
  }
  class Inner {
    +supervisor: ProcessSupervisor
    +runtimes: RuntimeManager
    +services: ServiceManager
    +web: WebManager
    +projects: ProjectStore
  }
  class ProcessSupervisor {
    +start(spec) ProcessId
    +stop(id)
    +output(id) lines
  }
  class RuntimeManager {
    +install(entry)
    +remove(id, version)
    +resolve(req) ResolvedRuntime
  }
  class WebManager {
    +apply(ctx) ApplyReport
    +validate() bool
    +rollback()
  }
  class DomainStore {
    +add(domain)
    +update(id, patch)
  }
  class CertificateManager {
    +ensure_for(host) CertPaths
    +ensure_lets_encrypt(domain) CertPaths
    +issue_lets_encrypt(domain) CertPaths
    +revoke(host)
  }
  class AcmeClient {
    +new(directory_url, account_key_file)
    +issue_certificate(hostname, doc_root, email) IssuedCert
  }
  class McpAuthConfig {
    +load() McpAuthConfig
    +is_expired() bool
    +is_ready() bool
  }
  class ServiceManager {
    +start(id)
    +stop(id)
    +status(id) ServiceStatus
    +subscribe_status_events() Broadcast<ServiceStateEvent>
  }
  class SetupPlanner {
    +plan() PlanStep[]
    +apply() SetupReport
  }
  Core --> Inner
  Inner --> ProcessSupervisor
  Inner --> RuntimeManager
  Inner --> ServiceManager
  Inner --> WebManager
  WebManager --> DomainStore
  WebManager --> CertificateManager
  CertificateManager --> AcmeClient
  Inner --> SetupPlanner
