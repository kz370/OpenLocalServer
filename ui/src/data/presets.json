{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "letos",
      "name": "Letos DB Browser",
      "engines": ["sqlite"],
      "launchMode": "args",
      "args": ["{path}"]
    },
    {
      "id": "dbbrowser",
      "name": "DB Browser for SQLite",
      "engines": ["sqlite"],
      "launchMode": "args",
      "args": ["{path}"]
    },
    {
      "id": "heidisql",
      "name": "HeidiSQL",
      "engines": ["mariadb", "postgres", "sqlite"],
      "launchMode": "args",
      "args": ["-h={host}", "-P={port}", "-u={user}", "-D={database}"]
    },
    {
      "id": "dbeaver",
      "name": "DBeaver",
      "engines": ["mariadb", "postgres", "sqlite"],
      "launchMode": "args",
      "args": ["-con", "driver=mysql|host={host}|port={port}|database={database}|user={user}"]
    },
    {
      "id": "pgadmin",
      "name": "pgAdmin 4",
      "engines": ["postgres"],
      "launchMode": "clipboard",
      "args": []
    },
    {
      "id": "nosqlbooster",
      "name": "NoSQLBooster for MongoDB",
      "engines": ["mongodb"],
      "launchMode": "clipboard",
      "args": []
    },
    {
      "id": "tinyrdm",
      "name": "Tiny RDM",
      "engines": ["redis"],
      "launchMode": "clipboard",
      "args": []
    }
  ]
}
